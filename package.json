{
  "name": "profecian-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "customer": "npm run web --workspace @profecian/customer",
    "vendor": "npm run web --workspace @profecian/vendor",
    "admin": "npm run web --workspace @profecian/admin",
    "test": "tsx --test packages/shared/test/city-pricing.test.ts packages/shared/test/vendor-job.test.ts packages/shared/test/release.test.ts packages/shared/test/extra-work.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "backend:seed": "tsx backend/scripts/generate-dev-seed.ts",
    "backend:up": "docker compose -f backend/docker-compose.yml up -d",
    "backend:down": "docker compose -f backend/docker-compose.yml down",
    "backend": "node backend/scripts/mvnw.mjs spring-boot:run",
    "backend:test": "node backend/scripts/mvnw.mjs verify"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
