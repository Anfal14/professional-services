{
  "expo": {
    "name": "Profecian",
    "slug": "Profecian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.profecian.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6E42E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.profecian.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Profecian – Home Services",
      "themeColor": "#6E42E5"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Profecian uses your location to fill in the service address for your booking."
        }
      ]
    ],
    "scheme": "profecian",
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
